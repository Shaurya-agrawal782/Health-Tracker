# ============================================================
# VitalIQ Health — Backend Environment Variables
# ============================================================
# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control.
#
#   cp backend/.env.example backend/.env
# ============================================================

# --- Server ---
# Port the Express server will listen on.
PORT=5000

# Node environment. Set to "production" on Render.
NODE_ENV=development

# --- Database ---
# MongoDB connection string. Use MongoDB Atlas for cloud hosting.
MONGO_URI=your_mongodb_connection_string_here

# --- Authentication ---
# Secret used to sign and verify JWT tokens. Use a long random string.
JWT_SECRET=your_secure_jwt_secret_here_min_32_chars

# How long access tokens remain valid (e.g. 7d, 24h, 30d).
JWT_EXPIRE=7d

# --- CORS ---
# URL of the deployed frontend. Must match the exact origin sent by browsers.
# Leave as localhost for local development.
FRONTEND_URL=http://localhost:5173

# --- Gemini AI ---
# API key from Google AI Studio (https://aistudio.google.com/).
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini model to use. Defaults to gemini-2.5-flash if omitted.
GEMINI_MODEL=gemini-2.5-flash

# --- Email (Nodemailer / Gmail SMTP) ---
# Gmail address used to send OTP verification emails.
EMAIL_USER=your_gmail_address@gmail.com

# Gmail App Password (16 chars, generated in Google Account → Security → App Passwords).
# Do NOT use your regular Gmail password here.
EMAIL_PASS=your_16_character_gmail_app_password

# --- ML Prediction Service (optional) ---
# URL of the external FastAPI / ML service for wellness predictions.
# Falls back to http://localhost:8000 if not set, and further falls back
# to Gemini AI analysis if the ML service is unreachable.
ML_API_URL=http://localhost:8000
