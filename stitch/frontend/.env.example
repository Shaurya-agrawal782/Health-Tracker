# ============================================================
# VitalIQ Health — Frontend Environment Variables
# ============================================================
# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control.
#
#   cp frontend/.env.example frontend/.env
# ============================================================

# --- Backend API ---
# Full base URL of the VitalIQ Health backend API (no trailing slash).
# For local development, point to the local Express server.
VITE_API_URL=http://localhost:5000/api

# For production (Render, etc.), use your deployed backend URL:
# VITE_API_URL=https://your-backend-service.onrender.com/api
